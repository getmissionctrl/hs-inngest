cabal-version:      3.0
name:               hs-inngest
version:            0.1.0.0
synopsis:           Native Haskell SDK for Inngest
license:            MIT
build-type:         Simple

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  default-language: Haskell2010
  exposed-modules:  Inngest
                    Inngest.Types
                    Inngest.Config
                    Inngest.Signing
                    Inngest.Client
                    Inngest.Step
                    Inngest.Function
  build-depends:    base >=4.14 && <5
                  , aeson >=2.0
                  , bytestring
                  , text
                  , scientific
                  , containers
                  , crypton
                  , memory
                  , http-client
                  , http-client-tls
                  , time
                  , transformers
                  , mtl
                  , unliftio

test-suite hs-inngest-test
  import:           warnings
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  default-language: Haskell2010
  build-tool-depends: hspec-discover:hspec-discover
  other-modules:    Inngest.TypesSpec
                    Inngest.ConfigSpec
                    Inngest.SigningSpec
                    Inngest.ClientSpec
                    Inngest.StepSpec
                    Inngest.FunctionSpec
  build-depends:    base, hs-inngest, hspec, aeson, bytestring, text, http-client
                  , time, containers
